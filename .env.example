# Generic
APP_ENV=development
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Backend
BACKEND_CORS_ORIGINS=http://localhost:5173

# DB (Postgres example)
DATABASE_URL=postgresql+psycopg2://pfmtools:pfmtools@db:5432/pfmtools

# Redis / RQ
REDIS_URL=redis://redis:6379/0
RQ_DEFAULT_QUEUE=pfmtools

# Data dirs (mounted in Docker later)
DATA_DIR=/data
UPLOADS_DIR=/data/uploads
PROCESSED_DIR=/data/processed

# WooCommerce API (placeholder)
WC_API_URL=https://example.com/wp-json/wc/v3
WC_CONSUMER_KEY=your_wc_key
WC_CONSUMER_SECRET=your_wc_secret

# Braintree (placeholder)
BT_ENVIRONMENT=sandbox
BT_MERCHANT_ID=your_merchant_id
BT_PUBLIC_KEY=your_public_key
BT_PRIVATE_KEY=your_private_key
