# PFM Tools Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Core Configuration
# ============================================================================
APP_ENV=development
SECRET_KEY=your-secret-key-here-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================================
# Database Configuration
# ============================================================================
# For Docker Compose (development)
DATABASE_URL=postgresql+psycopg2://pfmtools:pfmtools@db:5432/pfmtools
POSTGRES_PASSWORD=pfmtools
POSTGRES_DB=pfmtools
POSTGRES_USER=pfmtools

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://redis:6379/0
RQ_DEFAULT_QUEUE=pfmtools

# ============================================================================
# CORS Configuration
# ============================================================================
# For development (frontend on port 5173)
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
# For production (replace with your domain)
# BACKEND_CORS_ORIGINS=["https://tools.pfm-qa.com"]

# ============================================================================
# Data Directories
# ============================================================================
# These are mounted via Docker volumes (./data:/data)
DATA_DIR=/data
UPLOADS_DIR=/data/uploads
PROCESSED_DIR=/data/processed

# ============================================================================
# WooCommerce API Configuration (Optional)
# ============================================================================
WOO_BASE_URL=https://www.particleformen.com
WOO_CONSUMER_KEY=your-woocommerce-consumer-key
WOO_CONSUMER_SECRET=your-woocommerce-consumer-secret

# ============================================================================
# Braintree API Configuration (Optional)
# ============================================================================
BRAINTREE_MERCHANT_ID=your-braintree-merchant-id
BRAINTREE_PUBLIC_KEY=your-braintree-public-key
BRAINTREE_PRIVATE_KEY=your-braintree-private-key
BRAINTREE_ENVIRONMENT=sandbox
# BRAINTREE_ENVIRONMENT=production

# ============================================================================
# AfterShip API Configuration (Optional)
# ============================================================================
AFTERSHIP_USERNAME=your-aftership-username
AFTERSHIP_PASSWORD=your-aftership-password
AFTERSHIP_BASE_URL=https://api.us.afterpay.com

# ============================================================================
# Ulta Marketplace API Configuration (Optional)
# ============================================================================
ULTA_API_KEY=your-ulta-api-key
ULTA_GOOGLE_SHEETS_SPREADSHEET_ID=your-ulta-google-sheets-spreadsheet-id
ULTA_GOOGLE_SHEETS_SHEET_NAME=Main

# ============================================================================
# Inventory Data API Configuration (Optional)
# ============================================================================
# Zenventory KLB API
ZENVENTORY_KLB_USERNAME=your-zenventory-username
ZENVENTORY_KLB_PASSWORD=your-zenventory-password
ZENVENTORY_KLB_BASE_URL=https://app.zenventory.com/rest/inventory

# ShipBob API
SHIPBOB_API_KEY=your-shipbob-api-key
SHIPBOB_BASE_URL=https://api.shipbob.com/2025-07

# Inventory Data Google Sheets
INVENTORY_GOOGLE_SHEETS_SPREADSHEET_ID=your-inventory-google-sheets-spreadsheet-id

# ============================================================================
# Google Sheets OAuth Configuration (Optional)
# ============================================================================
# OAuth 2.0 credentials (for organization projects)
# Path relative to project root or absolute path
GOOGLE_SHEETS_OAUTH_CREDENTIALS_PATH=backend/credentials/client_secret_google_sheets.json
GOOGLE_SHEETS_OAUTH_TOKEN_PATH=backend/credentials/google_sheets_token.pickle

# Alternative: Service Account (if your org allows service account keys)
# GOOGLE_SHEETS_SERVICE_ACCOUNT_PATH=backend/credentials/service_account.json

# General Google Sheets settings (fallback if feature-specific not set)
GOOGLE_SHEETS_SPREADSHEET_ID=your-general-google-sheets-spreadsheet-id
GOOGLE_SHEETS_SHEET_NAME=Exports

# ============================================================================
# Frontend Build Configuration
# ============================================================================
# For development
VITE_API_BASE_URL=http://localhost:8000/api
# For production (replace with your domain)
# VITE_API_BASE_URL=https://tools.pfm-qa.com/api

# ============================================================================
# Production-specific (if using docker-compose.prod.yml)
# ============================================================================
# BACKEND_PORT=8000
# FRONTEND_PORT=8080
# BACKEND_WORKERS=2
